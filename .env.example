# Copy this file to .env and fill in your values before running docker-compose

# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=biometric_db

# App (used inside containers)
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/biometric_db
SECRET_KEY=change-this-to-a-long-random-string-min-32-chars
REDIS_URL=redis://redis:6379
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SIMILARITY_THRESHOLD=0.45
